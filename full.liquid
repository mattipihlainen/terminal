<style>
  .wx-screen { width:100%; height:100%; padding:18px 24px 14px; box-sizing:border-box; font-family:Arial,Helvetica,sans-serif; color:#000; background:#fff; overflow:hidden; }
  .wx-header { height:100px; display:flex; align-items:center; justify-content:space-between; border-bottom:3px solid #000; padding-bottom:10px; box-sizing:border-box; }
  .wx-current { width:54%; display:flex; align-items:center; }
  .wx-temp { font-size:78px; line-height:78px; font-weight:700; letter-spacing:-4px; margin-right:24px; white-space:nowrap; }
  .wx-current-label { font-size:13px; font-weight:700; text-transform:uppercase; letter-spacing:1.4px; margin-bottom:4px; }
  .wx-condition { font-size:25px; line-height:28px; font-weight:700; }
  .wx-feels { font-size:17px; margin-top:3px; }
  .wx-summary { width:43%; text-align:right; }
  .wx-day { font-size:13px; font-weight:700; letter-spacing:1px; text-transform:uppercase; margin-bottom:4px; }
  .wx-mode { font-size:28px; line-height:30px; font-weight:800; text-transform:uppercase; }
  .wx-highlow { font-size:17px; margin-top:4px; }
  .wx-rain { height:64px; display:flex; align-items:center; border-bottom:2px solid #000; }
  .wx-rain-symbol { width:50px; font-size:38px; font-weight:700; }
  .wx-rain-title { font-size:22px; line-height:24px; font-weight:800; text-transform:uppercase; }
  .wx-rain-detail { font-size:14px; line-height:16px; margin-top:2px; }
  .wx-section-title { font-size:13px; line-height:15px; font-weight:800; letter-spacing:1.1px; text-transform:uppercase; margin-bottom:6px; }
  .wx-hours { width:100%; display:flex; justify-content:space-between; }
  .wx-hour { width:12%; text-align:center; }
  .wx-hour-time { font-size:14px; line-height:16px; font-weight:700; white-space:nowrap; }
  .wx-hour-icon { font-size:25px; line-height:28px; height:28px; overflow:hidden; }
  .wx-hour-temp { font-size:27px; line-height:29px; font-weight:800; white-space:nowrap; }
  .wx-hour-rain { font-size:12px; line-height:14px; }
  .wx-hourly { padding-top:8px; }
  .wx-clare { border-bottom:2px solid #000; padding:8px 0 7px; }
  .wx-clare-title { font-size:18px; line-height:20px; font-weight:800; letter-spacing:.7px; text-transform:uppercase; margin-bottom:5px; }
  .wx-clare-grid { display:grid; grid-template-columns:1fr 1fr; column-gap:24px; }
  .wx-clare-label { font-size:11px; font-weight:800; text-transform:uppercase; letter-spacing:.9px; margin-bottom:2px; }
  .wx-clare-main { font-size:18px; line-height:20px; font-weight:800; }
  .wx-clare-detail { font-size:12px; line-height:14px; margin-top:2px; }
  .wx-clare-overnight { font-size:12px; line-height:14px; margin-top:5px; font-weight:700; }
  .wx-calendar { border-top:2px solid #000; margin-top:8px; padding-top:7px; }
  .wx-cal-grid { display:grid; grid-template-columns:1fr 1fr; column-gap:24px; row-gap:4px; }
  .wx-cal-row { display:flex; min-width:0; }
  .wx-cal-time { width:74px; font-size:14px; font-weight:800; flex:0 0 auto; }
  .wx-cal-title { font-size:15px; font-weight:700; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .wx-cal-location { font-size:11px; font-weight:400; }
  .wx-fun-row { border-top:2px solid #000; margin-top:8px; padding-top:7px; display:grid; grid-template-columns:1fr 1fr; column-gap:24px; }
  .wx-fun-right { border-left:1px solid #000; padding-left:20px; }
  .wx-joke-label { font-size:11px; line-height:13px; font-weight:800; letter-spacing:1.2px; text-transform:uppercase; margin-bottom:2px; }
  .wx-joke-question { font-size:17px; line-height:19px; font-weight:700; }
  .wx-joke-answer { font-size:14px; line-height:16px; margin-top:1px; }
  .wx-fact-text { font-size:16px; line-height:19px; font-weight:700; }
  .wx-footer { height:18px; display:flex; justify-content:space-between; align-items:flex-end; font-size:10px; line-height:11px; margin-top:4px; }
</style>

<div class="wx-screen">
  <div class="wx-header">
    <div class="wx-current">
      <div class="wx-temp">{{ current.temp }}°</div>
      <div>
        <div class="wx-current-label">Ottawa · Now</div>
        <div class="wx-condition">{{ current.condition }}</div>
        <div class="wx-feels">Feels like {{ current.feels }}°</div>
      </div>
    </div>

    <div class="wx-summary">
      <div class="wx-day">{{ date_label }}</div>
      <div class="wx-mode">{{ mode_title }}</div>
      <div class="wx-highlow">High {{ focus.high }}° · Low {{ focus.low }}°</div>
    </div>
  </div>

  {% if clare_work.active == true %}
    <div class="wx-clare">
      <div class="wx-clare-title">{% if clare_work.urgent == true %}⚠ {% endif %}Clare work tonight · {{ clare_work.event_time }}</div>
      <div class="wx-clare-grid">
        <div>
          <div class="wx-clare-label">{{ clare_work.walk_home.label }}</div>
          <div class="wx-clare-main">{{ clare_work.walk_home.temp }}° · feels {{ clare_work.walk_home.feels }}° · {{ clare_work.walk_home.condition }}</div>
          <div class="wx-clare-detail">{{ clare_work.walk_home.detail }}</div>
        </div>
      </div>
      <div class="wx-clare-overnight">Overnight: {{ clare_work.overnight }}</div>
    </div>
  {% else %}
    <div class="wx-rain">
      {% if weather_ok == false %}
        <div class="wx-rain-symbol">!</div>
      {% else %}
        {% if raincoat.needed == true %}
          <div class="wx-rain-symbol">☂</div>
        {% else %}
          <div class="wx-rain-symbol">✓</div>
        {% endif %}
      {% endif %}
      <div>
        <div class="wx-rain-title">{{ raincoat.title }}</div>
        <div class="wx-rain-detail">{{ raincoat.message }}</div>
      </div>
    </div>
  {% endif %}

  <div class="wx-hourly">
    <div class="wx-section-title">
      {% if mode == "evening" %}Tomorrow · Hour by hour{% else %}{% if mode == "school" %}Today · Before 3 PM{% else %}Upcoming weather{% endif %}{% endif %}
    </div>

    <div class="wx-hours">
      {% for hour in hours %}
        <div class="wx-hour">
          <div class="wx-hour-time">{{ hour.time }}</div>
          <div class="wx-hour-icon">{{ hour.icon }}</div>
          <div class="wx-hour-temp">{{ hour.temp }}°</div>
          <div class="wx-hour-rain">Rain {{ hour.pop }}%</div>
        </div>
      {% endfor %}
    </div>
  </div>

  {% if calendar.visible == true %}
    <div class="wx-calendar">
      <div class="wx-section-title">Today's calendar</div>
      {% if calendar.has_events == true %}
        <div class="wx-cal-grid">
          {% for event in calendar.events %}
            <div class="wx-cal-row">
              <div class="wx-cal-time">{{ event.time }}</div>
              <div class="wx-cal-title">
                {{ event.title }}
                {% if event.location != "" %}<div class="wx-cal-location">{{ event.location }}</div>{% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      {% else %}
        <div class="wx-cal-title">{{ calendar.empty_message }}</div>
      {% endif %}
    </div>
  {% endif %}

  {% if mode == "evening" and clare_work.active != true %}
    <div class="wx-calendar">
      <div class="wx-section-title">Tomorrow morning</div>
      <div class="wx-cal-title">Around {{ focus.morning_temp }}° at 7–8 AM · {{ focus.condition }}</div>
    </div>
  {% endif %}

  <div class="wx-fun-row">
    <div>
      <div class="wx-joke-label">Joke of the day</div>
      <div class="wx-joke-question">{{ joke.question }}</div>
      <div class="wx-joke-answer">{{ joke.answer }}</div>
    </div>
    <div class="wx-fun-right">
      <div class="wx-joke-label">Animal fact of the day</div>
      <div class="wx-fact-text">{{ animal_fact.text }}</div>
    </div>
  </div>

  <div class="wx-footer">
    <div>{% if stale == true %}Using last successful weather update{% else %}Ottawa, Ontario{% endif %}</div>
    <div>Updated {{ updated }}</div>
  </div>
</div>
